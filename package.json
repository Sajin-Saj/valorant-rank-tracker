{
  "name": "valorant-rank-tracker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "capture": "node scripts/capture.mjs",
    "test": "cargo test -p core && node --test tests/*.test.mjs",
    "check": "cargo fmt --check && cargo clippy --workspace --target wasm32-unknown-unknown -- -D warnings"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "wrangler": "4.143.0"
  },
  "overrides": {
    "undici": "7.29.1"
  }
}
